/* Kessler Family Design System — Qt Style Sheet
   paper-and-ink Wärme · Clay-Terracotta · Tea-Green
   =============================================================

   Button convention (Phase 13):
   Every QPushButton in the codebase MUST have one of three objectName values:
     - "primary"  Haupt-Aktion einer Seite/Form (orange filled pillow)
     - "text"     Sekundäre Aktion / Navigation (transparent pillow, hover effect)
     - "danger"   Destruktive Aktion (rose-tinted pillow)
   Exceptions: buttons with their own inline setStyleSheet() (review tiles,
   grade selectors, subject tabs) are intentionally non-standard.
   ============================================================= */

QWidget {
    color: #1e1b15;
    background: #faf7f2;
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 11pt;
}

QMainWindow, QStackedWidget {
    background: #faf7f2;
}

/* Labels, Checkboxen, Radios erben sonst die paper-50-Fläche aus QWidget
   und werden auf hellen Cards (paper-elevated) als sichtbare Kästchen
   gerendert. Hintergrund explizit transparent. */
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

/* Display-Headings — Fraunces (Serif) */
QLabel#title {
    font-family: "Fraunces", "Iowan Old Style", Georgia, serif;
    font-size: 32pt;
    font-weight: 500;
    color: #13110c;
    padding: 0;
    margin: 0;
}

QLabel#subtitle {
    font-family: "Fraunces", "Iowan Old Style", Georgia, serif;
    font-size: 17pt;
    color: #4a4538;
}

QLabel#h2 {
    font-family: "Fraunces", "Iowan Old Style", Georgia, serif;
    font-size: 22pt;
    color: #1e1b15;
}

/* Eyebrow — kleine Uppercase über Sektionen */
QLabel#eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 9pt;
    font-weight: 500;
    color: #6f6757;
    letter-spacing: 1.5pt;
}

QLabel#lede {
    font-family: "Fraunces", Georgia, serif;
    font-size: 14pt;
    color: #4a4538;
}

QLabel#bigNote {
    font-family: "Fraunces", Georgia, serif;
    font-size: 56pt;
    font-weight: 500;
}

QLabel#correct {
    color: #3e552d;
    font-weight: 600;
}

QLabel#wrong {
    color: #a8524f;
    font-weight: 600;
}

/* Cards — papierfarbene Container mit warmem Rand */
QFrame#card {
    background: #fffdf8;
    border: 1px solid #d8cdb8;
    border-radius: 16px;
    padding: 24px;
}

/* Action-Card (Hauptmenü-Kacheln + Library-Test-Karten) */
QFrame#actionCard {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 16px;
}

QFrame#actionCard[hover="true"] {
    background: #faf7f2;
    border: 1px solid #c26a3d;
}

/* Resume-Banner */
QFrame#resumeBanner {
    background: #f6e3bb;
    border: 1px solid #dfb968;
    border-radius: 12px;
}

/* Ergebnis-Detail-Card pro Frage */
QWidget#resultCard {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 12px;
    padding: 14px;
}

/* Kompakte Summary-Card mit Note + Punkte */
QFrame#summaryCard {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 14px;
}

/* Profilverwaltung: pro Profil eine Card-Reihe */
QFrame#profileRow {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 14px;
}

/* Card im Verlauf */
QFrame#attemptCard {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 14px;
}
QFrame#attemptCard[hover="true"] {
    background: #faf7f2;
    border: 1px solid #c26a3d;
}

/* Card auf "Was noch hakt"-Seite */
QFrame#topicCard {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 14px;
}

/* Avatar-Auswahl-Tiles im Profil-Dialog */
QFrame#avatarTile {
    background: #fffdf8;
    border: 1px solid #ebe3d5;
    border-radius: 12px;
}
QFrame#avatarTile:hover {
    background: #faf7f2;
    border: 1px solid #c26a3d;
}
QFrame#avatarTile[selected="true"] {
    background: #fbf1ea;
    border: 2px solid #c26a3d;
}

/* Profile-Karten (Picker) */
QFrame#profileCard {
    background: #fffdf8;
    border: 1px solid #d8cdb8;
    border-radius: 16px;
}

QFrame#profileCard[hover="true"] {
    background: #faf7f2;
    border: 1px solid #c26a3d;
}

QFrame#profileCardPlus {
    background: #f4efe6;
    border: 2px dashed #a89e89;
    border-radius: 16px;
}

QFrame#profileCardPlus[hover="true"] {
    background: #ebe3d5;
    border: 2px dashed #c26a3d;
}

QLabel#profileCardName {
    color: #1e1b15;
}

QLabel#profileCardMeta {
    color: #6f6757;
}

/* Profil-Chip in der Top-Bar des Menüs */
QFrame#profileChip {
    background: #fffdf8;
    border: 1px solid #d8cdb8;
    border-radius: 999px;
    padding: 4px 8px;
}

QLabel#profileChipAvatar {
    font-size: 14pt;
}

QLabel#profileChipName {
    color: #2f2b22;
    font-weight: 500;
    padding-right: 4px;
}

/* Buttons — ghost als Default, primary clay, secondary tea */
QPushButton {
    background: transparent;
    color: #2f2b22;
    border: 1px solid #d8cdb8;
    border-radius: 10px;
    padding: 10px 18px;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 11pt;
    min-height: 22px;
}

QPushButton:hover {
    background: #f4efe6;
    border-color: #a89e89;
}

QPushButton:pressed {
    background: #ebe3d5;
}

QPushButton:disabled {
    color: #a89e89;
    background: transparent;
    border-color: #ebe3d5;
}

QPushButton#primary {
    background: #c26a3d;
    color: #fffdf8;
    border: 1px solid #a25431;
}

QPushButton#primary:hover {
    background: #a25431;
}

QPushButton#primary:pressed {
    background: #7e4025;
}

QPushButton#secondary {
    background: #658a47;
    color: #fffdf8;
    border: 1px solid #506f39;
}

QPushButton#secondary:hover {
    background: #506f39;
}

QPushButton#danger {
    background: #a8524f;
    color: #fffdf8;
    border: 1px solid #7e3b39;
}

QPushButton#danger:hover {
    background: #7e3b39;
}

QPushButton#text {
    background: transparent;
    color: #a25431;
    border: none;
    padding: 6px 8px;
    text-decoration: underline;
}

QPushButton#text:hover {
    color: #7e4025;
}

/* Logo + wordmark + caret in the top bar — acts as the navigation menu trigger. */
QFrame#logoMenu {
    background: transparent;
    border-radius: 10px;
}
QFrame#logoMenu:hover {
    background: #f4efe6;
}

/* Card overflow trigger ("…") — no underline, no Qt menu-indicator arrow. */
QPushButton#cardOverflow {
    background: transparent;
    color: #6f6757;
    border: none;
    padding: 0;
    font-size: 16pt;
    font-weight: 600;
}
QPushButton#cardOverflow:hover {
    color: #1e1b15;
    background: #f4efe6;
    border-radius: 8px;
}
QPushButton#cardOverflow::menu-indicator {
    image: none;
    width: 0;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #fffdf8;
    color: #1e1b15;
    border: 1px solid #d8cdb8;
    border-radius: 10px;
    padding: 8px 12px;
    font-family: "Inter", sans-serif;
    selection-background-color: #f6ddc9;
    selection-color: #7e4025;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #c26a3d;
}

QComboBox {
    background: #fffdf8;
    border: 1px solid #d8cdb8;
    border-radius: 10px;
    padding: 6px 12px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #a89e89;
}

QComboBox QAbstractItemView {
    background: #fffdf8;
    border: 1px solid #d8cdb8;
    selection-background-color: #f4efe6;
    selection-color: #1e1b15;
    padding: 4px;
}

/* Listen & Tabellen */
QListWidget {
    background: #faf7f2;
    border: none;
    font-size: 11pt;
}

QListWidget::item {
    padding: 12px 14px;
    border-bottom: 1px solid #ebe3d5;
    color: #2f2b22;
}

QListWidget::item:hover {
    background: #f4efe6;
}

QListWidget::item:selected {
    background: #fbf1ea;
    color: #7e4025;
    border-left: 3px solid #c26a3d;
}

QTableWidget {
    background: #fffdf8;
    border: 1px solid #d8cdb8;
    border-radius: 12px;
    gridline-color: #ebe3d5;
    font-size: 11pt;
}

QTableWidget::item {
    padding: 8px;
    color: #2f2b22;
}

QTableWidget::item:selected {
    background: #fbf1ea;
    color: #7e4025;
}

QHeaderView::section {
    background: #f4efe6;
    color: #4a4538;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #d8cdb8;
    font-weight: 600;
    font-size: 10pt;
}

/* Radio + Checkbox — tea-grün wenn ausgewählt */
QRadioButton, QCheckBox {
    padding: 6px;
    spacing: 10px;
    color: #2f2b22;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QRadioButton::indicator {
    border-radius: 9px;
    border: 1.5px solid #a89e89;
    background: #fffdf8;
}

QRadioButton::indicator:checked {
    background: #658a47;
    border-color: #658a47;
}

QCheckBox::indicator {
    border-radius: 4px;
    border: 1.5px solid #a89e89;
    background: #fffdf8;
}

QCheckBox::indicator:checked {
    background: #658a47;
    border-color: #658a47;
}

/* Scrollbar — dezent, papierfarben */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d8cdb8;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #a89e89;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #d8cdb8;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #a89e89;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    width: 0;
}

/* Tooltip */
QToolTip {
    background: #2f2b22;
    color: #faf7f2;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 10pt;
}

/* Dialog */
QMessageBox, QDialog {
    background: #faf7f2;
}

QMessageBox QLabel {
    color: #2f2b22;
    font-size: 11pt;
}

/* ----- Phase 7: Schul-Cockpit ----- */

/* Top-bar Termine/Noten buttons */
QPushButton#topBarAction {
    background: transparent;
    color: #4a4538;
    border: 1px solid #d8cdb8;
    padding: 4px 12px;
    border-radius: 14px;
    font-size: 10pt;
}
QPushButton#topBarAction:hover {
    background: #f4efe6;
}

/* ExamCard (hero KA card on menu) */
ClickableCard#examCard {
    background: #fbf6ec;
    border: 1px solid #ead9be;
    border-radius: 14px;
}
ClickableCard#examCard:hover {
    background: #f6efde;
}

/* Compact tile (row of small tiles when KAs present) */
ClickableCard#compactTile {
    background: #fbf6ec;
    border: 1px solid #e6dac0;
    border-radius: 12px;
}
ClickableCard#compactTile:hover {
    background: #f3e9cf;
}

/* Empty-state row on menu */
QFrame#emptyEvents {
    background: transparent;
    border: 1px dashed #d8cdb8;
    border-radius: 12px;
}

/* Event list card (Termine page) */
ClickableCard#eventListCard {
    background: #fbf6ec;
    border: 1px solid #ead9be;
    border-radius: 12px;
}
ClickableCard#eventListCard[dimmed="true"] {
    background: #f4efe6;
    border: 1px solid #e1d7c1;
}

/* Subject tab buttons on Grades page */
QPushButton#subjectTab {
    background: transparent;
    color: #4a4538;
    border: 1px solid #d8cdb8;
    padding: 5px 14px;
    border-radius: 14px;
    font-size: 10pt;
}
QPushButton#subjectTab:checked {
    background: #3e552d;
    color: #f6f1e6;
    border-color: #3e552d;
}
QPushButton#subjectTab:hover:!checked {
    background: #f4efe6;
}

/* Grade hero card on Grades page */
QFrame#gradeHero {
    background: #fbf6ec;
    border: 1px solid #ead9be;
    border-radius: 16px;
}

/* Assessment card on Grades page */
QFrame#assessmentCard {
    background: #fbf6ec;
    border: 1px solid #ead9be;
    border-radius: 12px;
}

/* Comparison card inside assessment card */
QFrame#comparisonCard {
    background: #f4efe6;
    border: 1px solid #d8cdb8;
    border-radius: 10px;
}

/* Danger button (delete in dialogs) */
QPushButton#danger {
    background: transparent;
    color: #7e3b39;
    border: 1px solid #c9a5a2;
    padding: 5px 14px;
    border-radius: 10px;
}
QPushButton#danger:hover {
    background: #f6dcdb;
}

/* ----- Phase 8: Test bauen ----- */

/* Read-only prompt output area */
QPlainTextEdit#promptOutput {
    background: #fbf6ec;
    color: #1e1b15;
    border: 1px solid #ead9be;
    border-radius: 10px;
    padding: 12px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10pt;
}

/* ----- Phase 11: Responsive UI — focus rings & touch targets ----- */

/* Focus rings for keyboard + touch navigation */
QPushButton:focus,
QComboBox:focus,
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QRadioButton:focus,
QCheckBox:focus,
QDateEdit:focus {
    outline: none;
    border: 2px solid #3e552d;
}

ClickableCard:focus,
QFrame#profileRow:focus,
QFrame#profileCard:focus {
    border: 2px solid #3e552d;
}

/* Hamburger button (narrow-mode top-bar) */
QPushButton#hamburger {
    background: transparent;
    color: #4a4538;
    border: 1px solid #d8cdb8;
    border-radius: 22px;
    font-size: 18pt;
}
QPushButton#hamburger:hover {
    background: #f4efe6;
}
QPushButton#hamburger:focus {
    border: 2px solid #3e552d;
}

/* Touch-target minimum heights for primary/text/danger buttons */
QPushButton#primary,
QPushButton#text,
QPushButton#danger,
QPushButton#topBarAction {
    min-height: 44px;
}

/* Subject tabs on Grades page — taller for touch (was implicit ~36) */
QPushButton#subjectTab {
    background: transparent;
    color: #4a4538;
    border: 1px solid #d8cdb8;
    padding: 8px 16px;
    border-radius: 14px;
    font-size: 10pt;
    min-height: 44px;
}
QPushButton#subjectTab:checked {
    background: #3e552d;
    color: #f6f1e6;
    border-color: #3e552d;
}
QPushButton#subjectTab:hover:!checked {
    background: #f4efe6;
}

/* ----- Phase 12.2: Daily-5 Card styling (was missing from Phase 10 QSS) ----- */

ClickableCard#dailyCard {
    background: #fbf6ec;
    border: 1px solid #ead9be;
    border-radius: 14px;
}
ClickableCard#dailyCard:hover {
    background: #f6efde;
}

/* Sticky action bar at the bottom of long edit pages.
   Lives outside the ScrollArea so save/delete stay reachable while scrolling. */
QFrame#stickyFooter {
    background: #fffdf8;
    border-top: 1px solid #ebe3d5;
}

/* Form-section header (e.g. "Schul-Kontext", "Schulkalender") */
QLabel#sectionHeader {
    color: #1e1b15;
    font-weight: 600;
    padding-top: 8px;
}

/* Field hint below an input ("Findest du im Schulportal unter …") */
QLabel#fieldHint {
    color: #a89e89;
    font-size: 9pt;
}
